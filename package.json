{
  "name": "mytalents-tutor-workday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch backend/src/server.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "check:web": "node scripts/check-web.mjs",
    "start": "node --env-file-if-exists=.env dist/backend/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test backend/test/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "openapi": "tsx scripts/export-openapi.ts",
    "demo:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts",
    "evaluate": "tsx scripts/evaluate-marking.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.2.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
