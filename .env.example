# Local synthetic demo. No Google credentials are required.
HOST=127.0.0.1
PORT=3100
AUTH_MODE=demo
REPOSITORY=local
DATA_FILE=data/private/workday.json
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,http://localhost:5173,http://127.0.0.1:5173

# Production must use AUTH_MODE=token, an explicit CORS allowlist, and HTTPS.
# Token principals are server-side configuration. Never put these in frontend code.
# API_KEYS_JSON=[{"token":"replace-with-32-or-more-random-characters","id":"tutor-1","role":"teacher","studentIds":["student-1"]}]

# Dedicated app-owned spreadsheet, shared with a service account as Editor.
# REPOSITORY=sheets
# GOOGLE_SPREADSHEET_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
# Exactly one backend writer per spreadsheet. Existing unrelated tabs are preserved.

# Optional two-stage AI service implementing docs/integrations.md.
# It receives cropped page images and rubric data ONLY when a scan job is requested.
# AI_GATEWAY_URL=https://your-authorized-ai-service.example/v1
# AI_GATEWAY_TOKEN=
# NOTIFICATION_DRIVER=outbox
